# Existing Sub2API service and its machine-only Admin API Key.
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_ADMIN_API_KEY=admin-replace-me

# Optional read-only PostgreSQL DSN used only for online-user aggregate views.
# Use a dedicated role with default_transaction_read_only=on, connection limit 2,
# TLS when supported, and SELECT grants only for the documented aggregate tables/identity columns.
# When empty, every unrelated sidecar feature remains available and online users
# are shown as unavailable. Do not reuse Sub2API's writer credential.
AUTO_SCHEDULER_ONLINE_DATABASE_URL=

# Browser-facing URL of this sidecar and the origin of the Sub2API admin UI.
AUTO_SCHEDULER_PUBLIC_URL=https://sub2api.example.com/account-auto-scheduler/
AUTO_SCHEDULER_UI_ORIGIN=https://sub2api.example.com

AUTO_SCHEDULER_LISTEN_ADDR=:8091
AUTO_SCHEDULER_DATA_FILE=/data/state.json

# Required for upstream login/sync and direct API-key account probes. Generate a dedicated key with:
# openssl rand -base64 32
# Leave empty only to keep legacy Sub2API-based scheduling enabled while disabling
# upstream login/sync and administrator authorization of direct probes.
# Rotating this key requires reconnecting upstream identities and reauthorizing direct probes.
AUTO_SCHEDULER_CREDENTIAL_KEY=
# 0 disables periodic upstream sync; otherwise use 60-86400 seconds.
AUTO_SCHEDULER_UPSTREAM_SYNC_SECONDS=600
# Bark 告警状态评估间隔，允许 15-86400 秒。仅读取本地快照，不触发额外上游同步。
AUTO_SCHEDULER_NOTIFICATION_INTERVAL_SECONDS=30

AUTO_SCHEDULER_AUTO_REGISTER_TAB=true
AUTO_SCHEDULER_TRUST_PROXY_HEADERS=true
AUTO_SCHEDULER_MAX_CONCURRENCY=5
AUTO_SCHEDULER_AUTH_CACHE_SECONDS=30
AUTO_SCHEDULER_SHUTDOWN_SECONDS=15
